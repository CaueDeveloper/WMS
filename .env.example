# Gere uma chave nova para produção com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme-generate-a-new-random-secret-key
DJANGO_DEBUG=True

# Produção: liste os hosts/IPs reais separados por vírgula (ex.: 10.61.1.10,wms.cafedositio.local)
DJANGO_ALLOWED_HOSTS=

# Produção: origens confiáveis para POST via CSRF, separadas por vírgula
# (necessário se o WMS for acessado por HTTPS, ex.: https://wms.cafedositio.local)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Ativa SSL redirect + cookies seguros + HSTS — só ligar se houver HTTPS de fato na frente
DJANGO_SECURE_SSL_REDIRECT=False

# Banco de dados: deixe DJANGO_DB_NAME vazio para usar SQLite (padrão de desenvolvimento).
# Preencha para produção com MySQL.
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306

IMPRESSORA_ZPL_HOST=0.0.0.0
IMPRESSORA_ZPL_PORT=9100

AUTH_LDAP_SERVER_URI=
# Conta de bind (leitura) no AD — use uma conta de serviço dedicada, não uma conta
# pessoal. AUTH_LDAP_BIND_DN/PASSWORD (padrão django-auth-ldap) têm prioridade se
# definidos; senão, caem para user_ad/senha_ad (nomes já usados neste projeto).
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
user_ad=
senha_ad=
# Domínio usado para montar o UPN (usuario@dominio) no bind, se o AD exigir esse
# formato e user_ad/AUTH_LDAP_BIND_DN não vier com "@" já incluso.
AUTH_LDAP_BIND_USER_DOMAIN=
AUTH_LDAP_USER_SEARCH_BASE=
AUTH_LDAP_GROUP_SEARCH_BASE=
AUTH_LDAP_GROUP_DN_ADMINISTRADORES=
AUTH_LDAP_GROUP_DN_OPERADOR_PRODUCAO=
AUTH_LDAP_GROUP_DN_OPERADOR_LOGISTICA=
AUTH_LDAP_GROUP_DN_GESTOR_PRODUCAO=
AUTH_LDAP_GROUP_DN_GESTOR_LOGISTICA=
# Enquanto o AD só tem grupos "guarda-chuva" por área (sem subgrupos Operador/Gestor),
# cada DN abaixo dá acesso total ao setor (Operador + Gestor); ver comentário
# [TRANSIÇÃO] em wms/settings.py.
AUTH_LDAP_GROUP_DN_PRODUCAO=
AUTH_LDAP_GROUP_DN_LOGISTICA=
